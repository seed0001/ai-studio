# Postgres connection string (e.g. from Neon, Railway, or a local instance)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_studio"

# App URL — used for OAuth callbacks and Stripe redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Google OAuth (console.cloud.google.com > APIs & Services > Credentials)
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — used for magic-link sign-in emails (resend.com)
AUTH_RESEND_KEY=""
EMAIL_FROM="AI Studio <noreply@yourdomain.com>"

# OpenRouter — used for music generation (openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Cloudflare R2 — used to store generated audio files
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public URL the bucket is served from (custom domain or r2.dev subdomain)
R2_PUBLIC_URL=""

# Stripe (dashboard.stripe.com)
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the webhook endpoint's signing secret in production
STRIPE_WEBHOOK_SECRET=""
# Price IDs for each credit pack (Stripe Dashboard > Product catalog).
# Must be one-time prices, not recurring.
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_CREATOR=""
STRIPE_PRICE_PRO=""
