# App URL — used for the OpenRouter HTTP-Referer header
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OpenRouter — used for music generation (openrouter.ai/keys)
OPENROUTER_API_KEY=""

# Cloudflare R2 — used to store generated audio files
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public URL the bucket is served from (custom domain or r2.dev subdomain)
R2_PUBLIC_URL=""
